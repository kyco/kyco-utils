{
  "name": "@kyco-utils/types",
  "version": "0.1.3",
  "description": "Shared, dependency-free TypeScript types for kyco-utils.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyco/kyco-utils.git",
    "directory": "packages/types"
  },
  "homepage": "https://github.com/kyco/kyco-utils/tree/main/packages/types",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@kyco-utils/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
