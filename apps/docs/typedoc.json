{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "entryPoints": ["../../packages/search", "../../packages/number", "../../packages/enums", "../../packages/types"],
  "entryPointStrategy": "packages",
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "readme": "none",
    "sort": ["source-order"],
    "groupOrder": ["Functions", "Enumerations", "Variables", "Schemas", "Type Aliases", "*"]
  },
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "out": "src/api",
  "readme": "none",
  "docsRoot": "src",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "disableSources": true,
  "hideGenerator": true,
  "outputFileStrategy": "modules",
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "useCodeBlocks": true,
  "sidebar": {
    "collapsed": false
  },
  "name": "API reference",
  "typeDeclarationVisibility": "compact",
  "typeAliasPropertiesFormat": "table",
  "parametersFormat": "table",
  "expandObjects": true,
  "enumMembersFormat": "table"
}
