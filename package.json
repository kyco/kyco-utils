{
  "name": "kyco-utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" dev",
    "test": "pnpm -r test",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} + && find . -name pnpm-lock.yaml -type f -delete",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "update-packages": "pnpm dlx npm-check-updates --format group --cooldown 1 -i"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@changesets/cli": "^3.0.3",
    "@kyco-utils/biome-config": "workspace:*",
    "@types/node": "^26.6.6",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
