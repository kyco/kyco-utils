{
  "name": "kyco-utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run -r --parallel dev",
    "test": "vp run -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "vp run -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "update-packages": "pnpm dlx npm-check-updates --format group --cooldown 1 -i"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "^3.0.3",
    "@kyco-utils/biome-config": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite-plus": "1.5.0"
  }
}
